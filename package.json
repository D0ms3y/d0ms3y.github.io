{
  "name": "domsey.dev",
  "version": "0.0.1",
  "description": "My personal homepage",
  "scripts": {
    "start": "npm run build:pdf && rimraf ./dist ./.parcel-cache && parcel src/views/index.ejs src/views/cv.ejs",
    "serve": "npx serve dist",
    "build": "npm run build:pdf && parcel build src/views/index.ejs src/views/cv.ejs --public-url ./",
    "build:pdf": "rimraf ./.tmp-pdf && parcel build src/views/cv.ejs --dist-dir .tmp-pdf --public-url ./ && node scripts/generate-pdf.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D0ms3y/D0ms3y.github.io.git"
  },
  "author": "D0ms3y",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/D0ms3y/D0ms3y.github.io/issues"
  },
  "homepage": "https://domsey.dev",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.3.2",
    "@tailwindcss/postcss": "^4.2.2",
    "autoprefixer": "^10.5.0",
    "bootstrap": "^5.1.3",
    "ejs": "^3.1.6",
    "jquery": "^3.6.0",
    "parcel-transformer-ejs": "^0.2.0",
    "postcss": "^8.5.8",
    "puppeteer": "^25.7.0",
    "sass": "^1.32.8",
    "tailwindcss": "^4.2.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@popperjs/core": "^2.11.2",
    "lightbox2": "^2.11.3",
    "parcel": "^2.3.2",
    "parcel-namer-custom": "^0.2.0",
    "rimraf": "^3.0.2"
  },
  "parcel-namer-custom": {
    ".ejs?$": "[name].[type]",
    ".js?$": "[folder]/[name].[hash].[type]",
    ".scss?$": "css/[name].[hash].[type]",
    ".png?$|.gif?$": "img/[name].[hash].[type]",
    ".pdf?$": "docs/[name].[type]",
    ".woff2?$|.ttf?$": "fonts/[name].[hash].[type]"
  }
}
