<section
  id="about"
  class="min-h-screen flex items-center pt-20 px-8 max-w-7xl mx-auto relative overflow-hidden"
>
  <div class="grid md:grid-cols-2 gap-12 items-center z-10">
    <div class="space-y-8">
      <div
        class="inline-block px-4 py-1.5 rounded-full bg-white dark:bg-surface-container-high text-brand-primary dark:text-primary font-bold tracking-widest uppercase border border-slate-200 dark:border-outline-variant/10 text-xs shadow-sm"
      >
        Currently: Consultant / Full-Stack Developer @ bridgingIT
      </div>
      <h1
        class="font-headline text-5xl md:text-7xl font-extrabold tracking-tight leading-[1.1] text-light-text dark:text-on-background"
      >
        Dominik Borowski:
        <span class="text-brand-primary dark:text-primary-fixed-dim"
          >Full-Stack Developer</span
        >
        crafting digital experiences.
      </h1>
      <p
        class="font-body text-xl text-slate-600 dark:text-on-surface-variant max-w-lg leading-relaxed"
      >
        I specialize in building robust, scalable applications with a focus on
        clean code, performance, and user-centric design.
      </p>
      <div class="flex flex-wrap gap-4 pt-4">
        <a
          class="px-8 py-4 bg-brand-primary dark:bg-primary-dim text-white dark:text-on-primary rounded-full font-bold text-lg hover:scale-105 transition-transform shadow-lg shadow-brand-primary/30 dark:shadow-primary-dim/30"
          href="#portfolio"
        >
          View my work
        </a>
        <a
          class="px-8 py-4 border border-slate-300 dark:border-outline-variant/30 text-light-text dark:text-on-background rounded-full font-bold text-lg hover:bg-slate-50 dark:hover:bg-surface-bright transition-colors"
          href="#contact"
        >
          Let's talk
        </a>
      </div>
    </div>
    <div class="relative group">
      <div
        class="absolute inset-0 bg-gradient-to-tr from-brand-primary/20 dark:from-primary-dim/20 to-tertiary-dim/20 rounded-3xl blur-3xl group-hover:blur-2xl transition-all"
      ></div>
      <div
        class="relative bg-white dark:bg-surface-container-high rounded-3xl overflow-hidden aspect-square border border-slate-200 dark:border-outline-variant/10 shadow-2xl"
      >
        <img
          alt="Dominik Borowski Profile"
          class="w-full h-full object-cover"
          data-alt="Professional headshot of a developer in a modern dark studio setting with subtle blue rim lighting, minimalist and high-end aesthetic"
          src="../img/dominik-borowski.1024x1024.jpg"
        />
      </div>
    </div>
  </div>
  <!-- Decorative Background Element -->
  <div
    class="absolute top-1/4 -right-20 w-96 h-96 bg-brand-primary/5 dark:bg-primary-container/10 rounded-full blur-[120px] pointer-events-none"
  ></div>
</section>
