<section id="career" class="py-32 px-8 max-w-7xl mx-auto">
  <div class="mb-20">
    <span class="font-label text-brand-primary dark:text-tertiary font-bold tracking-widest flex items-center gap-2"
      >01. JOURNEY <span class="text-xs opacity-50 font-japanese">/ 経歴</span>
      </span>
    <h2 class="font-headline text-4xl font-bold mt-4 text-light-text dark:text-on-background">
      Professional Trajectory
    </h2>
  </div>
  <div class="space-y-6">
    <!-- Timeline Item 1 -->
    <% locals.careerSteps.forEach(function(step) { %>
        <div
      class="grid md:grid-cols-4 gap-8 bg-white dark:bg-surface-container p-8 rounded-xl items-start border border-slate-100 dark:border-outline-variant/5 shadow-sm dark:shadow-none"
    >
      <div class="md:col-span-1">
        <span class="text-slate-500 dark:text-on-surface-variant font-mono"
          ><%= step.from %> — <%= step.to %></span
        >
      </div>
      <div class="md:col-span-3 flex gap-6">
        <div
          class="w-12 h-12 bg-slate-50 dark:bg-surface-bright rounded-lg flex items-center justify-center shrink-0 border border-slate-100 dark:border-none"
        >
          <span
            class="material-symbols-outlined text-brand-primary dark:text-primary"
            data-icon="<%= step.icon %>"
            ><%= step.icon %></span
          >
        </div>
        <div>
          <h3 class="font-headline text-xl font-bold text-light-text dark:text-on-background">
            <%= step.title %>
          </h3>
          <p class="text-slate-600 dark:text-on-surface-variant mt-2 leading-relaxed">
            <%= step.description %>
          </p>
        </div>
      </div>
    </div>
    <% }); %>
  </div>
</section>

