<section id="skills" class="py-32 bg-slate-50 dark:bg-surface-container-low">
  <div class="max-w-7xl mx-auto px-8">
    <div class="mb-20 text-center">
      <span class="font-label text-brand-primary dark:text-primary font-bold tracking-widest flex items-center justify-center gap-2"
        >02. ARSENAL
        <span class="text-xs opacity-50 font-japanese">/ スキル</span>
      </span>
      <h2 class="font-headline text-4xl font-bold mt-4 text-light-text dark:text-on-background">
        Technical Proficiency
      </h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      <!-- Category: Languages -->
      <div
        class="bg-white dark:bg-surface-container-high p-8 rounded-xl space-y-8 border border-slate-200 dark:border-outline-variant/10 shadow-sm"
      >
        <div class="flex items-center gap-4">
          <span
            class="material-symbols-outlined text-brand-primary dark:text-primary"
            data-icon="data_object"
            >data_object</span
          >
          <h3 class="text-xl font-bold text-light-text dark:text-on-background">Languages / 言語</h3>
        </div>
        <div class="flex flex-wrap gap-3">
        <% locals.languages.forEach(function(language) { %>
            <span class="px-4 py-2 bg-light dark:bg-surface-container rounded-md border border-outline-variant/15 text-light dark:text-on-surface-variant font-body text-sm hover:border-primary/40 hover:text-primary transition-colors cursor-default"><%= language.name %></span>
        <% }); %>
        </div>
      </div>
      <!-- Category: Frameworks -->
      <div
        class="bg-white dark:bg-surface-container-high p-8 rounded-xl space-y-8 border border-slate-200 dark:border-outline-variant/10 shadow-sm"
      >
        <div class="flex items-center gap-4">
          <span
            class="material-symbols-outlined text-brand-primary dark:text-primary"
            data-icon="layers"
            >layers</span
          >
          <h3 class="text-xl font-bold text-light-text dark:text-on-background">Frameworks / 基盤</h3>
        </div>
        <div class="flex flex-wrap gap-3">
        <% locals.frameworks.forEach(function(framework) { %>
            <span class="px-4 py-2 bg-light dark:bg-surface-container rounded-md border border-outline-variant/15 text-light dark:text-on-surface-variant font-body text-sm hover:border-primary/40 hover:text-primary transition-colors cursor-default"><%= framework.name %></span>
        <% }); %>
        </div>
      </div>
      <!-- Category: Tools -->
      <div
        class="bg-white dark:bg-surface-container-high p-8 rounded-xl space-y-8 border border-slate-200 dark:border-outline-variant/10 shadow-sm"
      >
        <div class="flex items-center gap-4">
          <span
            class="material-symbols-outlined text-brand-primary dark:text-primary"
            data-icon="construction"
            >construction</span
          >
          <h3 class="text-xl font-bold text-light-text dark:text-on-background">Tools / ツール</h3>
        </div>
        <div class="flex flex-wrap gap-3">
        <% locals.tools.forEach(function(tool) { %>
            <span class="px-4 py-2 bg-light dark:bg-surface-container rounded-md border border-outline-variant/15 text-light dark:text-on-surface-variant font-body text-sm hover:border-primary/40 hover:text-primary transition-colors cursor-default"><%= tool.name %></span>
        <% }); %>
        </div>
      </div>
    </div>
  </div>
</section>
