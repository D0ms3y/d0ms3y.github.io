<!DOCTYPE html>
<html class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="../css/tailwind.css" />
  <link rel="stylesheet" href="../scss/styles.scss" />
  <title>CV - Dominik Borowski</title>
  <style>
    /* Force A4 size and hide scrollbars */
    @page {
      size: A4;
      margin: 0;
    }
    body {
      width: 210mm;
      height: 297mm;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }
  </style>
</head>
<body class="bg-background text-on-background font-body print:bg-background print:text-on-background">

  <div class="w-full h-full p-10 flex flex-col box-border relative overflow-hidden">
    <!-- Header / About -->
    <header class="flex items-center gap-8 mb-8 border-b border-outline-variant/10 pb-6 z-10">
      <div class="w-28 h-28 shrink-0 bg-surface-container-high rounded-full overflow-hidden border border-outline-variant/10 shadow-lg">
        <img src="../img/dominik-borowski.1024x1024.jpg" class="w-full h-full object-cover" />
      </div>
      <div>
        <div class="inline-block px-3 py-1 mb-2 rounded-full bg-surface-container-high text-primary font-bold tracking-widest uppercase border border-outline-variant/10 text-[10px]">
          Consultant / Full-Stack Developer @ bridgingIT
        </div>
        <h1 class="font-headline text-4xl font-extrabold tracking-tight leading-tight">
          Dominik Borowski
        </h1>
        <p class="text-on-surface-variant text-sm mt-2 max-w-lg leading-relaxed">
          I specialize in building robust, scalable applications with a focus on clean code, performance, and user-centric design.
        </p>
      </div>
    </header>

    <!-- Main Content: 2 Columns -->
    <main class="flex-1 grid grid-cols-[1fr_2fr] gap-10 z-10">
      
      <!-- Left Column: Skills & Contact -->
      <aside class="space-y-8">
        <!-- Skills -->
        <section>
          <h2 class="font-headline text-lg font-bold mb-4 text-primary uppercase tracking-wider flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">build</span> Skills
          </h2>
          
          <div class="space-y-4">
            <div>
              <h3 class="text-[11px] font-bold text-on-surface-variant mb-2 uppercase tracking-wide">Languages</h3>
              <div class="flex flex-wrap gap-1.5">
                <% locals.languages.forEach(function(language) { %>
                  <span class="px-2 py-1 bg-surface-container rounded border border-outline-variant/15 text-[10px]"><%= language.name %></span>
                <% }); %>
              </div>
            </div>
            
            <div>
              <h3 class="text-[11px] font-bold text-on-surface-variant mb-2 uppercase tracking-wide">Frameworks</h3>
              <div class="flex flex-wrap gap-1.5">
                <% locals.frameworks.forEach(function(framework) { %>
                  <span class="px-2 py-1 bg-surface-container rounded border border-outline-variant/15 text-[10px]"><%= framework.name %></span>
                <% }); %>
              </div>
            </div>
            
            <div>
              <h3 class="text-[11px] font-bold text-on-surface-variant mb-2 uppercase tracking-wide">Tools</h3>
              <div class="flex flex-wrap gap-1.5">
                <% locals.tools.forEach(function(tool) { %>
                  <span class="px-2 py-1 bg-surface-container rounded border border-outline-variant/15 text-[10px]"><%= tool.name %></span>
                <% }); %>
              </div>
            </div>
          </div>
        </section>
        
        <!-- Contact (Hardcoded for CV context, adjust as needed) -->
        <section>
           <h2 class="font-headline text-lg font-bold mb-4 text-primary uppercase tracking-wider flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">contact_mail</span> Contact
          </h2>
          <div class="space-y-2 text-xs text-on-surface-variant">
            <p><strong>Email:</strong> dominik@db-rm.dev</p>
            <p><strong>GitHub:</strong> github.com/D0ms3y</p>
            <p><strong>Website:</strong> domsey.dev</p>
            <p><strong>Location:</strong> Germany</p>
          </div>
        </section>
      </aside>

      <!-- Right Column: Career -->
      <section>
        <h2 class="font-headline text-lg font-bold mb-6 text-primary uppercase tracking-wider flex items-center gap-2">
          <span class="material-symbols-outlined text-sm">work</span> Professional Trajectory
        </h2>
        
        <div class="space-y-5">
          <% locals.careerSteps.forEach(function(step) { %>
            <div class="relative pl-6 border-l-2 border-surface-container-high pb-2">
              <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-primary ring-4 ring-background"></div>
              
              <div class="flex justify-between items-baseline mb-1">
                <h3 class="font-headline text-sm font-bold text-on-background">
                  <%= step.title %>
                </h3>
                <span class="text-[9px] text-on-surface-variant font-mono bg-surface-container-high px-2 py-0.5 rounded">
                  <%= step.from %> — <%= step.to %>
                </span>
              </div>
              <p class="text-[11px] text-on-surface-variant leading-relaxed">
                <%= step.description %>
              </p>
            </div>
          <% }); %>
        </div>
      </section>
      
    </main>

    <!-- Decorative Background -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary-container/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-tertiary-dim/5 rounded-full blur-[80px] pointer-events-none -z-10"></div>
  </div>

</body>
</html>
