<section id="portfolio" class="py-32 px-8 max-w-7xl mx-auto">
  <div class="mb-20 flex justify-between items-end">
    <div>
      <span
        class="font-label text-brand-primary dark:text-tertiary font-bold tracking-widest flex items-center gap-2"
      >
        03. WORK <span class="text-xs opacity-50 font-japanese">/ 実績</span>
      </span>
      <h2 class="font-headline text-4xl font-bold mt-4 text-light-text dark:text-on-background">Selected Projects</h2>
    </div>
    <div class="hidden md:block">
      <p class="text-slate-600 dark:text-on-surface-variant max-w-xs text-sm">
        A curation of projects focusing on architectural integrity and seamless
        user interaction.
      </p>
    </div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-6 gap-6">
    <% locals.projectReferences.forEach(function(project) { %>
      <% if (project.type == 'large') { %>
        <!-- Large Project Card -->
        <div
          class="md:col-span-4 bg-white dark:bg-surface-container rounded-3xl overflow-hidden group border border-slate-200 dark:border-outline-variant/10 hover:border-brand-primary/30 dark:hover:border-primary/30 transition-colors shadow-sm"
        >
          <div class="aspect-video relative overflow-hidden">
            <img
              alt="<%= project.title %>"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              data-alt="<%= project.title %>"
              src="<%= project.coverImage %>"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-white dark:from-background via-transparent opacity-80"
            ></div>
          </div>
          <div class="p-8">
            <div class="flex flex-wrap gap-2 mb-4">
              <% project.tags.forEach(function(tag) { %>
                <span
                class="px-3 py-1 bg-slate-100 dark:bg-surface-bright text-xs rounded-md font-mono text-brand-primary dark:text-primary"
                ><%= tag %></span
              >
              <% }); %>
            </div>
            <h3 class="text-2xl font-bold mb-2 text-light-text dark:text-on-background"><%= project.title %></h3>
            <p class="text-slate-600 dark:text-on-surface-variant leading-relaxed"><%= project.description.substring(0, 150) %>...</p>
            <button class="flex items-center gap-1 text-primary dark:text-on-background font-bold hover:underline text-sm pt-5 btn-read-more" data-project-id="<%= project.id %>">Read more<span class="material-symbols-outlined text-[16px]" data-icon="arrow_forward">arrow_forward</span></button>
          </div>
        </div>
      <% } %>
      <% if (project.type == 'small') { %>
        <!-- Small Project Card 1 -->
        <div
          class="md:col-span-2 bg-white dark:bg-surface-container rounded-3xl overflow-hidden group border border-slate-200 dark:border-outline-variant/10 hover:border-brand-primary/30 dark:hover:border-tertiary/30 transition-colors shadow-sm"
        >
          <div class="aspect-square relative overflow-hidden">
            <img
              alt="<%= project.title %>"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              data-alt="<%= project.title %>"
              src="<%= project.coverImage %>"
            />
          </div>
          <div class="p-8">
            <div class="flex flex-wrap gap-2 mb-4">
              <% project.tags.forEach(function(tag) { %>
                <span
                class="px-3 py-1 bg-slate-100 dark:bg-surface-bright text-xs rounded-md font-mono text-brand-primary dark:text-tertiary"
                ><%= tag %></span
              >
              <% }); %>
            </div>
            <h3 class="text-xl font-bold mb-2"><%= project.title %></h3>
            <p class="text-on-surface-variant text-sm"><%= project.description.substring(0, 150) %>...</p>
            <button class="flex items-center gap-1 text-primary dark:text-on-background font-bold hover:underline text-sm pt-5 btn-read-more" data-project-id="<%= project.id %>">Read more<span class="material-symbols-outlined text-[16px]" data-icon="arrow_forward">arrow_forward</span></button>
          </div>
        </div>
      <% } %>
      <% if (project.type == 'github') { %>
        <!-- GitHub CTA Card (Subtle Banner) -->
        <a href="<%= project.url %>" target="_blank" rel="noopener noreferrer"
          class="md:col-span-4 self-start bg-white dark:bg-surface-container rounded-3xl overflow-hidden group border border-slate-200 dark:border-outline-variant/10 hover:border-brand-primary/30 dark:hover:border-tertiary/30 transition-all shadow-sm flex flex-col md:flex-row items-center justify-between p-8 md:p-10"
        >
          <div class="flex flex-col md:flex-row items-center md:items-start text-center md:text-left gap-6 mb-8 md:mb-0">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-surface-bright flex items-center justify-center text-slate-600 dark:text-on-surface-variant group-hover:text-brand-primary dark:group-hover:text-primary transition-colors flex-shrink-0 mx-auto md:mx-0">
              <i class="fa-brands fa-github text-4xl"></i>
            </div>
            <div>
              <h3 class="text-2xl font-bold mb-2 text-slate-900 dark:text-on-background font-headline"><%= project.title %></h3>
              <p class="text-slate-500 dark:text-on-surface-variant text-sm max-w-sm leading-relaxed"><%= project.description %></p>
            </div>
          </div>
          
          <div class="flex-shrink-0">
             <div class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-slate-200 dark:border-outline-variant/30 text-slate-700 dark:text-on-surface font-bold group-hover:bg-slate-50 dark:group-hover:bg-surface-bright transition-colors text-sm">
              Visit Profile <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </div>
          </div>
        </a>
      <% } %>
    <% }); %>
  </div>
</section>
